// Template of Secrets.xcconfig, the per-developer settings of iosApp. Secrets.xcconfig is gitignored; create it with
//   cp iosApp/Configuration/Secrets.template.xcconfig iosApp/Configuration/Secrets.xcconfig
// and fill in the values. Never commit Secrets.xcconfig.

// Your Apple developer team ID, for signing on a real iPhone (Xcode > Settings > Accounts). Simulator builds work
// with it empty.
DEVELOPMENT_TEAM =

// The LAN MQTT broker host per configuration (plaintext MQTT, port 1883), which Debug builds connect to. The build
// writes it into the BrokerHost key of Info.plist, where the app reads it. The Simulator reaches the Mac's broker as
// localhost. For a real iPhone, use the Mac's LAN IP (`ipconfig getifaddr en0`; the same value as DEBUG_BROKER_HOST in
// secrets.properties). Release builds connect to AWS IoT instead (AMAZON_IOT_ENDPOINT below) and don't use it.
BROKER_HOST[config=Debug] = localhost
BROKER_HOST[config=Release] = localhost

// Cognito sign-in, per configuration: the dev stack for Debug, the prod stack for Release (the outputs of the
// pliuskis-backend stacks). The values below are dummies. The build writes the first four into Info.plist, where the
// shared framework reads them. An xcconfig file treats `//` as the start of a comment, so write the `//` of the
// redirect URI as `/$()/`: `lt.setkus.pliuskis:/$()/signin` is `lt.setkus.pliuskis://signin`.
COGNITO_USER_POOL_ID[config=Debug] = eu-north-1_EXAMPLE
COGNITO_USER_POOL_ID[config=Release] = eu-north-1_EXAMPLE
COGNITO_APP_CLIENT_ID[config=Debug] = exampleappclientid
COGNITO_APP_CLIENT_ID[config=Release] = exampleappclientid
COGNITO_LOGIN_DOMAIN[config=Debug] = example-dev.auth.eu-north-1.amazoncognito.com
COGNITO_LOGIN_DOMAIN[config=Release] = example.auth.eu-north-1.amazoncognito.com
COGNITO_REDIRECT_URI[config=Debug] = lt.setkus.pliuskis:/$()/signin
COGNITO_REDIRECT_URI[config=Release] = lt.setkus.pliuskis:/$()/signin

// The MQTT connection to AWS IoT over Cognito credentials, per configuration: identity pool, region and AWS IoT
// endpoint of the dev stack for Debug and of the prod stack for Release. The values below are dummies. The build writes
// them into Info.plist. Release always connects to AWS IoT with them; Debug uses them only when launched with
// `-awsIotCheck YES` (AwsIotCheck.swift), and otherwise uses the LAN broker (BROKER_HOST).
COGNITO_IDENTITY_POOL_ID[config=Debug] = eu-north-1:00000000-0000-0000-0000-000000000000
COGNITO_IDENTITY_POOL_ID[config=Release] = eu-north-1:00000000-0000-0000-0000-000000000000
AWS_REGION[config=Debug] = eu-north-1
AWS_REGION[config=Release] = eu-north-1
AMAZON_IOT_ENDPOINT[config=Debug] = example-dev-ats.iot.eu-north-1.amazonaws.com
AMAZON_IOT_ENDPOINT[config=Release] = example-ats.iot.eu-north-1.amazonaws.com

// Apple revoke on account deletion, per configuration: the pliuskis-backend stack's apple_revoke_api_url output (dev
// for Debug, prod for Release), into the AppleRevokeApiUrl key of Info.plist. Write its `//` as `/$()/`. With the
// dummies an Apple user's "Delete account" fails and keeps the account.
APPLE_REVOKE_API_URL[config=Debug] = https:/$()/example-dev.execute-api.eu-north-1.amazonaws.com
APPLE_REVOKE_API_URL[config=Release] = https:/$()/example.execute-api.eu-north-1.amazonaws.com
